ALTER ROLE historian_gold_compiler  LOGIN PASSWORD '${HISTORIAN_GOLD_COMPILER_PW}';

-- historian_adjudicator is a GROUP role and is NOT given a login. Each adjudicating
-- human gets their own credential and a registry row, because a shared service account
-- cannot supply human provenance (G-S6). One block per human:
--
--   CREATE ROLE adj_<human> LOGIN PASSWORD '${ADJ_<HUMAN>_PW}';
--   GRANT historian_adjudicator TO adj_<human>;
--   INSERT INTO adjudicator_principal(db_principal, human_id, display_name)
--        VALUES ('adj_<human>', '<human-id>', '<Display Name>');
--
